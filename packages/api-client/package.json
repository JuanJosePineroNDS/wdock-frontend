{
  "name": "@wdock/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/api/schema/} -o ./src/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "openapi-fetch": "^0.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
