# Base URL of the backend API.
# In dev, leave empty to use Vite's `/api` proxy (see vite.config.ts).
VITE_API_BASE_URL=

# Display name for the app (used in titles and headings).
VITE_APP_NAME=App

# Registration mode. One of: CLOSED, INVITATION, PUBLIC.
# Must match the backend's REGISTRATION_MODE setting.
VITE_REGISTRATION_MODE=CLOSED
